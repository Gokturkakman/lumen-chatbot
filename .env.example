# ─────────────────────────────────────────────────────────────
#  ZORUNLU / REQUIRED
# ─────────────────────────────────────────────────────────────

# Oturum çerezlerini imzalar. Üret: openssl rand -base64 32
AUTH_SECRET=

# https://aistudio.google.com/apikey  (ücretsiz, kart gerekmez)
# Gemini modellerini ve YouTube video özetlemeyi çalıştırır.
GOOGLE_GENERATIVE_AI_API_KEY=

# https://neon.tech  → projenin connection string'i
# postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
POSTGRES_URL=

# ─────────────────────────────────────────────────────────────
#  OPSİYONEL / OPTIONAL — yoksa uygulama yine çalışır
# ─────────────────────────────────────────────────────────────

# https://console.groq.com/keys  (ücretsiz, kart gerekmez)
# Llama / Kimi / GPT-OSS model ailelerini açar. Yoksa sadece Gemini görünür.
GROQ_API_KEY=

# https://exa.ai  — RSS bulunamayan yayın kuruluşları için yedek haber araması,
# web araması ve LinkedIn profil okuma. Yoksa haberler sadece RSS'ten gelir.
EXA_API_KEY=

# https://jina.ai — LinkedIn profil okumayı iyileştirir. Anahtarsız da çalışır
# (r.jina.ai ücretsiz katman), sadece hız limiti daha düşük olur.
JINA_API_KEY=
